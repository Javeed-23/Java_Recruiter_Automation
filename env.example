# Copy this file to ".env" and fill it in. NEVER commit ".env" to GitHub.
# Safe default: demo mode, emails go ONLY to your own test address.
DEMO_MODE=true
TEST_RECIPIENT=your.own.test.address@gmail.com

# Throw-away Gmail account for testing. Use a Google "App Password" (needs 2-step verification), not your real password.
GMAIL_ADDRESS=your.test.account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: a job-search API you are authorised to use (leave empty to stay on demo data)
JOB_API_URL=
JOB_API_KEY=
